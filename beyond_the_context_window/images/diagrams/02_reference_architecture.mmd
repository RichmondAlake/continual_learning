flowchart TB
    classDef user fill:#1a0714,stroke:#f472b6,stroke-width:2px,color:#fce7f3
    classDef app fill:#061a22,stroke:#22d3ee,stroke-width:2px,color:#cffafe
    classDef llm fill:#160a2b,stroke:#c084fc,stroke-width:2px,color:#f3e8ff
    classDef db fill:#03210f,stroke:#34d399,stroke-width:2px,color:#d1fae5
    classDef mem fill:#221d03,stroke:#facc15,stroke-width:2px,color:#fef9c3
    classDef code fill:#0f1a05,stroke:#a3e635,stroke-width:2px,color:#ecfccb
    classDef data fill:#042f2e,stroke:#2dd4bf,stroke-width:2px,color:#ccfbf1
    classDef gate fill:#241400,stroke:#fbbf24,stroke-width:2px,color:#fef3c7
    subgraph TRAIN["Training path · off the critical path"]
        direction TB
        C["<b>contrastive.jsonl</b><br/>question · unit · hard negative"]:::data --> T["<b>Fine-tune</b> with MNRL<br/>→ models/embedder/v1<br/>weights + model card"]:::code
        T --> R["<b>Re-index</b><br/>every memory unit, with v1"]:::code
        R --> G["<b>Promotion check</b><br/>Calderwood nDCG@10 lift ≥ 0.02<br/>SciFact nDCG@10 drop ≤ 0.01"]:::gate
    end
    subgraph SERVE["Serving path · every question"]
        direction TB
        H["<b>Handler's question</b>"]:::user --> E["<b>Embedder vN</b><br/>question → vector"]:::llm
        E --> I[("<b>Index vN</b><br/>48 units, embedded by vN")]:::db
        I --> A["<b>Ada</b><br/>top-k units in context"]:::app
    end
    G -- "pass" --> P{{"<b>ACTIVE = vN</b><br/>rollback: point it back;<br/>the old index is still on disk"}}:::gate
    P --> E
    P --> I
